import hashlib

def brute_force_md5():
    # Kırılmak istenen hedef MD5 özeti (Bu özet "1234" şifresine aittir)
    hedef_hash = "81dc9bdb52d04dc20036dbd8313ed055"

    print("Brute force (Kaba kuvvet) şifre kırma işlemi başlatıldı...\n")

    # 0000'dan 9999'a kadar tüm olasılıkları tek tek deniyoruz
    for i in range(10000):
        # Sayıyı 4 haneli metne (string) çeviriyoruz (Örn: 5 rakamı -> "0005" olur)
        denenen_sifre = str(i).zfill(4)

        # Denenen şifrenin MD5 özetini (hash) alıyoruz.
        # hashlib kütüphanesi byte formatında veri kabul ettiği için önce .encode() kullanıyoruz.
        uretilen_hash = hashlib.md5(denenen_sifre.encode()).hexdigest()

        # Ürettiğimiz özet ile kırmaya çalıştığımız hedef özet aynı mı diye kontrol ediyoruz
        if uretilen_hash == hedef_hash:
            print(f"[+] Başarılı! Hash çözümlendi.")
            print(f"[+] Orijinal Şifre: {denenen_sifre}")
            return # Şifreyi bulduğumuz için döngüyü ve fonksiyonu sonlandırıyoruz

    print("[-] Şifre bu aralıkta bulunamadı.")

# Kodu çalıştır
brute_force_md5()





