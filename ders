import hashlib
import itertools
import string

gizli_metin = "abc"

karakter_seti = string.ascii_lowercase

maks_uzunluk = 4

hedef_hash = hashlib.md5(gizli_metin.encode()).hexdigest()
print(f"Kırılacak hash: {hedef_hash}")

deneme = 0
bulundu = False

for uzunluk in range(1, maks_uzunluk + 1):

    if bulundu:
        break

    for kombinasyon in itertools.product(karakter_seti, repeat=uzunluk):

        aday = ''.join(kombinasyon)
        deneme += 1

        aday_hash = hashlib.md5(aday.encode()).hexdigest()

        if aday_hash == hedef_hash:
            print(f"Bulundu! '{aday}' -- {deneme} denemede cozuldu.")
            bulundu = True
            break

if not bulundu:
    print(f"Bulunamadi. ({deneme} deneme yapildi)")


