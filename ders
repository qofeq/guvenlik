import hashlib
import itertools
import string

# 1. Hocanın quizde size vereceği hedef kelime
hedef_kelime = "siber"

# Hedef kelimenin MD5 özetini arka planda sistem kendisi hesaplıyor
hedef_hash = hashlib.md5(hedef_kelime.encode()).hexdigest()
print(f"[*] Aranan hash oluşturuldu: {hedef_hash}\n")

# 2. Denemelerde kullanılacak karakter seti (a'dan z'ye küçük harfler)
karakterler = string.ascii_lowercase 

print("[*] Saf Brute Force başlatıldı. Tüm harf kombinasyonları üretiliyor...\n")

bulundu = False

# 3. Kelimenin kaç harfli olduğunu bilmediğimizi varsayarak, 
# 1 harfliden başlayıp 5 harfliye kadar tüm ihtimalleri sırayla deniyoruz.
# (Eğer kelime daha uzunsa range(1, 6) kısmını büyütebilirsin)
for uzunluk in range(1, 6):
    print(f"--- {uzunluk} karakterli kombinasyonlar deneniyor ---")
    
    # itertools.product, verdiğimiz karakterlerle 'uzunluk' kadar tüm permütasyonları üretir
    for kombinasyon in itertools.product(karakterler, repeat=uzunluk):
        
        # Üretilen ('s', 'i', 'b', 'e', 'r') gibi yapıyı "siber" kelimesine çeviriyoruz
        denenen_kelime = "".join(kombinasyon)
        
        # [span_0](start_span)Ürettiğimiz kelimenin MD5 özetini alıyoruz[span_0](end_span)
        uretilen_hash = hashlib.md5(denenen_kelime.encode()).hexdigest()
        
        # Hedef hash ile ürettiğimiz hash eşleşiyor mu?
        if uretilen_hash == hedef_hash:
            print(f"\n[+] BAŞARILI! Eşleşme bulundu.")
            print(f"[+] Çözülen Kelime: {denenen_kelime}")
            bulundu = True
            break # Eşleşme bulunca içteki döngüyü kırıyoruz
            
    if bulundu:
        break # İçeride bulduğumuz için dıştaki döngüyü de tamamen bitiriyoruz
